

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Funções de Ajuda ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      // O Super Admin tem acesso total. 
      // Verifica o campo 'superAdmin' na coleção de mapeamento de utilizadores.
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserMapData(request.auth.uid).superAdmin == true;
    }

    // Igual à app (useSubscriptionState): só bloqueia empresas suspensas/inactivas ou trial expirado.
    // Antes: empresa SEM campo 'status' (criada antes das subscrições) era recusada em tudo,
    // e 'trialEndsAt' (texto ISO) passado a timestamp.value() dava erro → trial também recusado.
    function isCompanySubscriptionActive(companyId) {
      let company = get(/databases/$(database)/documents/companies/$(companyId)).data;
      let status = company.get('status', 'active');
      let ends = company.get('trialEndsAt', null);
      // paidUntilMs: fim da subscrição paga (+ dias de tolerância), gravado só pelo servidor (PaySuite).
      let paid = company.get('paidUntilMs', null);
      return !(status in ['suspended', 'inactive']) && (
        status != 'trial' ||
        ends == null ||
        // 'trialEndsAt' é texto ISO ("2026-10-17T07:50:12.123Z"). string(request.time) NÃO existe nas regras (dava erro e recusava
        // tudo), por isso lê-se a data do texto e compara-se como timestamp (UTC).
        (ends is string && ends.size() >= 19 && request.time < (
          timestamp.date(int(ends[0:4]), int(ends[5:7]), int(ends[8:10]))
          + duration.time(int(ends[11:13]), int(ends[14:16]), int(ends[17:19]), 0))) ||
        (ends is int && request.time < timestamp.value(ends)) ||
        (ends is timestamp && request.time < ends)
      ) && (
        status != 'active' || paid == null || !(paid is int) || request.time < timestamp.value(paid)
      );
    }
    
    function getUserMapData(userId) {
      // Busca o mapeamento do utilizador na coleção de topo.
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function getUserCompanyId(userId) {
      // Retorna o companyId do mapa de utilizadores.
      return getUserMapData(userId).companyId;
    }
    
    function getUserEmployeeData(userId) {
      // Busca os dados detalhados do funcionário a partir da subcoleção da sua empresa.
      let companyId = getUserCompanyId(userId);
      return get(/databases/$(database)/documents/companies/$(companyId)/employees/$(userId)).data;
    }

    function isEmployeeOf(companyId) {
      // O utilizador pertence à empresa se o companyId no seu mapa corresponder ou se for Super Admin.
      return isSignedIn() && (getUserCompanyId(request.auth.uid) == companyId || isSuperAdmin());
    }
    
    function isAdminOf(companyId) {
      // É admin da empresa se pertencer a ela e a sua role for 'Admin' ou se for Super Admin.
      return isEmployeeOf(companyId) && (getUserEmployeeData(request.auth.uid).role == 'Admin' || isSuperAdmin());
    }
    
    // Gestor da empresa (Admin ou Dono) — quem pode corrigir/apagar registos já feitos.
    function isManagerOf(companyId) {
      return isEmployeeOf(companyId) && (getUserEmployeeData(request.auth.uid).role in ['Admin', 'Dono'] || isSuperAdmin());
    }

    function can(module, level) {
      let hasMap = isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      let companyId = hasMap ? getUserCompanyId(request.auth.uid) : '';
      let hasEmployee = hasMap && exists(/databases/$(database)/documents/companies/$(companyId)/employees/$(request.auth.uid));
      let employeeData = hasEmployee ? get(/databases/$(database)/documents/companies/$(companyId)/employees/$(request.auth.uid)).data : {};
      let role = employeeData.get('role', '');
      let permissions = employeeData.get('permissions', {});
      let perm = permissions.get(module, '');
      return isSuperAdmin() || (
        hasEmployee && (
          (role == 'Admin' && module != 'companies') ||
          (role == 'Dono' && level == 'read') ||
          (level == 'write' && perm == 'write') ||
          (level == 'read' && (perm == 'read' || perm == 'write'))
        )
      );
    }

    // --- Regras por Coleção ---

    // Registo das conversas com o assistente (só escrita pelo próprio; leitura só Super Admin)
    match /assistant_logs/{logId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow get, list: if isSuperAdmin();
    }

    // Referências de pagamento PaySuite → empresa. Só o servidor (Admin SDK) acede.
    match /billingRefs/{ref} {
      allow read, write: if false;
    }

    // Coleção de mapeamento de utilizadores
    match /users/{userId} {
      // Um utilizador só pode ler o seu próprio mapa. Admins não podem ler mapas de outros.
      allow read: if request.auth.uid == userId || isSuperAdmin();
      // A criação (onboarding) só pode ser feita pelo próprio utilizador.
      allow create: if request.auth.uid == userId;
      // Atualização: CRÍTICO - Prevenir mudança de companyId ou superAdmin (privilege escalation)
      allow update: if request.auth.uid == userId && 
        request.resource.data.companyId == resource.data.companyId &&
        (!request.resource.data.keys().hasAny(['superAdmin']) || request.resource.data.superAdmin == resource.data.get('superAdmin', false));
      allow delete: if false; // Nunca permitir eliminação de user maps
    }


    // A coleção 'companies' só pode ser listada pelo Super Admin.
    // Admins de empresa podem ler os dados da sua própria empresa.
    match /companies/{companyId} {
      allow create: if isSignedIn(); // Qualquer pessoa autenticada pode registar uma nova empresa.
      allow get: if isEmployeeOf(companyId);
      allow list: if isSuperAdmin();
      allow update: if isSuperAdmin() || (isAdminOf(companyId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'trialEndsAt', 'subscriptionEndsAt', 'paidUntilMs', 'plan']))
        // Quem vende (não só o Admin) precisa de avançar a numeração dos documentos: só esses dois campos, e o contador nunca recua.
        || (can('sales', 'write') && isCompanySubscriptionActive(companyId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saleCounter', 'documentNumbering'])
            && request.resource.data.get('saleCounter', 0) >= resource.data.get('saleCounter', 0));

      // Pagamentos da subscrição (PaySuite): só o servidor escreve; o admin vê o histórico.
      match /payments/{paymentId} {
        allow get, list: if isAdminOf(companyId);
        allow write: if false;
      }
      allow delete: if isSuperAdmin();

      // Regras para as subcoleções de cada empresa.
      // O acesso é sempre verificado pela função can(módulo, nível).
      match /employees/{employeeId} {
        // Um funcionário pode ler os seus próprios dados.
        allow get: if request.auth.uid == employeeId || can('users', 'read');
        allow list: if can('users', 'read');
        // A criação é permitida se o utilizador tiver permissão de escrita OU se for o fundador a registar a empresa (onboarding).
        allow create: if can('users', 'write') || (
          request.auth.uid == employeeId && 
          request.resource.data.role == 'Admin' &&
          getAfter(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid
        );
        // Atualização: Prevenir auto-promoção (privilege escalation)
        allow update: if can('users', 'write') && (
          // Admin pode atualizar, mas não pode mudar role ou companyId de forma arbitrária
          request.resource.data.role == resource.data.role &&
          request.resource.data.companyId == resource.data.companyId
        );
        allow delete: if can('users', 'write');
      }
      
      match /catalogProducts/{productId} {
          allow get, list: if can('settings', 'read') || can('inventory', 'read') || can('sales', 'read');
          // Quem cria um produto novo (Stock Rápido, Inventário) acrescenta-o ao catálogo; alterar/apagar fica para as Definições.
          allow create: if (can('settings', 'write') || can('inventory', 'write')) && (isCompanySubscriptionActive(companyId) || isSuperAdmin());
          allow update, delete: if can('settings', 'write') && (isCompanySubscriptionActive(companyId) || isSuperAdmin());
      }
      
      match /catalogCategories/{categoryId} {
          allow get, list: if can('settings', 'read') || can('inventory', 'read') || can('sales', 'read');
          // Quem cria um produto novo (Stock Rápido, Inventário) acrescenta-o ao catálogo; alterar/apagar fica para as Definições.
          allow create: if (can('settings', 'write') || can('inventory', 'write')) && (isCompanySubscriptionActive(companyId) || isSuperAdmin());
          allow update, delete: if can('settings', 'write') && (isCompanySubscriptionActive(companyId) || isSuperAdmin());
      }
      
      match /products/{productId} {
        allow get, list: if can('inventory', 'read');
        allow create, update, delete: if can('inventory', 'write') && (isCompanySubscriptionActive(companyId) || isSuperAdmin());
      }

      match /stockMovements/{movementId} {
        allow get, list: if can('inventory', 'read');
        allow create: if can('inventory', 'write');
        // Nenhum update/delete em movimentos de stock para garantir imutabilidade
        allow update, delete: if false; 
      }
      
      // Vendas: depois de feitas, só o gestor as corrige ou apaga. O vendedor só pode avançar o
      // fluxo normal (marcar como pago, levantar) e mexer em notas/cliente — nunca em produto,
      // quantidade, preço, totais, data, autor ou apagar — e nunca baixar o valor já pago.
      match /sales/{saleId} {
        allow get, list: if can('sales', 'read');
        allow create: if can('sales', 'write') && (isCompanySubscriptionActive(companyId) || isSuperAdmin());
        allow update: if can('sales', 'write') && (isCompanySubscriptionActive(companyId) || isSuperAdmin()) && (
          isManagerOf(companyId) || (
            // Venda feita sem internet: ao sincronizar recebe o número oficial (e só isso muda).
            resource.data.get('offlinePending', false) == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guideNumber', 'provisionalNumber', 'offlinePending'])
            && request.resource.data.get('offlinePending', false) == false
          ) || (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'productId', 'productName', 'quantity', 'unit', 'unitPrice', 'unitCost', 'subtotal', 'discount', 'vat',
              'totalValue', 'date', 'soldBy', 'guideNumber', 'location', 'documentType', 'orderId', 'transactionId',
              'deletedAt', 'deletedBy', 'timestamp'
            ]) &&
            request.resource.data.get('amountPaid', 0) >= resource.data.get('amountPaid', 0)
          )
        );
        allow delete: if isManagerOf(companyId) && can('sales', 'write');

        // Registo de cada correcção (quem, quando, antes e depois). Imutável.
        match /history/{historyId} {
          allow get, list: if isManagerOf(companyId);
          allow create: if can('sales', 'write') && request.resource.data.userId == request.auth.uid;
          allow update, delete: if false;
        }
      }
      
      // Documentos (cotações, facturas, recibos, guias…). Rascunhos: qualquer pessoa com permissão de vendas edita e apaga.
      // Emitidos: só o gestor corrige (e fica registado em /history), e nunca se apagam — anulam-se.
      match /documents/{docId} {
        allow get, list: if can('sales', 'read');
        allow create: if can('sales', 'write') && (isCompanySubscriptionActive(companyId) || isSuperAdmin());
        allow update: if can('sales', 'write') && (isCompanySubscriptionActive(companyId) || isSuperAdmin())
          && (resource.data.status == 'draft' || isManagerOf(companyId));
        allow delete: if can('sales', 'write') && resource.data.status == 'draft';

        // Registo de cada correcção a um documento emitido (quem, quando, antes e depois). Imutável.
        match /history/{historyId} {
          allow get, list: if isManagerOf(companyId);
          allow create: if isManagerOf(companyId) && request.resource.data.userId == request.auth.uid;
          allow update, delete: if false;
        }
      }

      match /productions/{productionId} {
        allow get, list: if can('production', 'read');
        allow create, update, delete: if can('production', 'write') && (isCompanySubscriptionActive(companyId) || isSuperAdmin());
      }
      
      match /rawMaterials/{materialId} {
        allow get, list: if can('raw-materials', 'read');
        allow create, update, delete: if can('raw-materials', 'write') && (isCompanySubscriptionActive(companyId) || isSuperAdmin());
      }
      
      match /recipes/{recipeId} {
        allow get, list: if can('raw-materials', 'read');
        allow create, update, delete: if can('raw-materials', 'write') && (isCompanySubscriptionActive(companyId) || isSuperAdmin());
      }
      
      match /orders/{orderId} {
        allow get, list: if can('orders', 'read');
        allow create, update, delete: if can('orders', 'write') && (isCompanySubscriptionActive(companyId) || isSuperAdmin());
      }
      
      // Clientes: usados em Clientes, Vendas, Encomendas e no Dashboard.
      match /customers/{customerId} {
        allow get, list: if can('customers', 'read') || can('sales', 'read') || can('orders', 'read') || can('dashboard', 'read');
        allow create, update: if (can('customers', 'write') || can('sales', 'write') || can('orders', 'write')) && (isCompanySubscriptionActive(companyId) || isSuperAdmin());
        allow delete: if can('customers', 'write') && (isCompanySubscriptionActive(companyId) || isSuperAdmin());
      }

      // Aparelhos que recebem notificações push (o ID do documento é o token FCM).
      // Cada utilizador só grava/apaga o seu; só o servidor (Admin SDK) lê para enviar.
      match /pushTokens/{token} {
        allow create, update: if isEmployeeOf(companyId) && request.resource.data.userId == request.auth.uid;
        allow delete: if isEmployeeOf(companyId) && resource.data.userId == request.auth.uid;
        allow read: if false;
      }

      // Central de notificações (estilo Facebook): todos os funcionários vêem; cada um só marca como lida.
      match /notifications/{notificationId} {
        allow get, list: if isEmployeeOf(companyId);
        allow create: if isEmployeeOf(companyId) && request.resource.data.actorId == request.auth.uid;
        allow update: if isEmployeeOf(companyId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
        allow delete: if false;
      }

      // Preços de venda diferentes do habitual, à espera da decisão do gestor.
      // O vendedor cria-os ao vender; só o gestor (Admin) lê e decide.
      match /priceReviews/{reviewId} {
        allow create: if can('sales', 'write');
        allow get, list, update: if isAdminOf(companyId);
        allow delete: if false;
      }

      // Despesas (módulo Financeiro).
      match /expenses/{expenseId} {
        allow get, list: if can('finance', 'read');
        allow create, update, delete: if can('finance', 'write') && (isCompanySubscriptionActive(companyId) || isSuperAdmin());
      }

      match /reports/{reportId} {
        // Relatórios são tipicamente apenas de leitura para a maioria dos papéis.
        allow get, list: if can('reports', 'read');
        allow create, update, delete: if can('reports', 'write');
      }
    }

    // ReplayX (plataforma de trading): cada utilizador lê e grava só os seus próprios dados
    // (layout, desenhos, sessões de replay, estratégias, alertas), guardados como JSON.
    match /replayx_users/{uid}/state/{key} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid
        && key in ['settings', 'workspace', 'drawings', 'trading', 'strategies', 'alerts']
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'savedAt'])
        && request.resource.data.data is string;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }
    // Plano do ReplayX (plan, subscriptionEndsAt, paidUntilMs) e pagamentos: o utilizador só lê; só o servidor escreve.
    match /replayx_users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /replayx_users/{uid}/payments/{paymentId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
